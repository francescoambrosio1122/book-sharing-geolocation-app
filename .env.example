# Configurazione del progetto Book Sharing Geolocation App

PORT=3000
API_BASE_URL=http://localhost:3000/api
NODE_ENV=development

# Database SQLite locale
DATABASE_PATH=./backend/book_sharing.db

# In una versione futura potrebbero essere aggiunte variabili come:
# JWT_SECRET=secret_key_for_authentication
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# CLOUD_DATABASE_URL=database_connection_string
